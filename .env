# AI API Configuration
# Choose your provider: openai, groq, anthropic
API_PROVIDER=openai

# Your API key (required)
API_KEY=your_api_key_here

# Model to use
# OpenAI: gpt-3.5-turbo, gpt-4, gpt-4-turbo
# Groq: mixtral-8x7b-32768, llama2-70b-4096
# Anthropic: claude-3-opus-20240229, claude-3-sonnet-20240229
MODEL=gpt-3.5-turbo

# Voice Settings
# Voice ID: 0 (usually male), 1 (usually female) - depends on system
VOICE_ID=0

# Voice rate (words per minute, typical range: 100-200)
VOICE_RATE=150

# Voice volume (0.0 to 1.0)
VOICE_VOLUME=0.9

# WolframAlpha API Key (optional)
# Get your free API key at: https://products.wolframalpha.com/api/
# Free plan: 2,000 queries/month
WOLFRAM_API_KEY=your_wolfram_api_key_here

# ═══════════════════════════════════════════════════════════════
# MULTI-CHANNEL CONFIGURATION
# ═══════════════════════════════════════════════════════════════

# Telegram Bot
# Get your token from @BotFather on Telegram
TELEGRAM_TOKEN=your_telegram_bot_token_here

# Optional: Restrict bot to specific users (comma-separated Telegram user IDs)
# Leave empty to allow all users
# Example: TELEGRAM_ALLOWED_USERS=123456789,987654321
TELEGRAM_ALLOWED_USERS=

# Discord Bot (coming soon)
# DISCORD_TOKEN=your_discord_bot_token_here
# DISCORD_ALLOWED_GUILDS=
